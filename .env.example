# ===================================================
# Kurius Platform — Environment Template (.env.example)
# Copy this file to .env at the project root
# ===================================================

# ---------------------------------------------------
# Backend (Express.js / API) Configuration
# ---------------------------------------------------
NODE_ENV=development
IP_ADDRESS=localhost
PORT=5000
ENABLE_API_DOCS=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kurius_db?schema=public"

# Security & Bcrypt
BCRYPT_SALT_ROUNDS=10

# JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE_IN=90d

# SMTP & Email Configuration
EMAIL_FROM=noreply@kurius.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="your_app_password"
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com

# Session & OAuth
SESSION_SECRET=your_session_secret_key_here
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Default Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=admin@kurius.com
SUPER_ADMIN_PASSWORD=Password123!

# ---------------------------------------------------
# Frontend (Next.js / Web Admin & Portal) Configuration
# ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
