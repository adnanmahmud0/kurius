datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum USER_ROLES {
  SUPER_ADMIN
  ADMIN
  USER
}

enum Status {
  active
  delete
}

enum Provider {
  local
  google
  facebook
  github
}

model User {
  id             String      @id @default(uuid())
  name           String
  firstName      String?
  lastName       String?
  role           USER_ROLES
  contact        String?
  email          String      @unique
  password       String?
  location       String?
  image          String?     @default("https://i.ibb.co.com/d0KBxkHm/f2011bfb4e87a2e5219bd4c2fb02a5e9.jpg")
  avatar         String?     @default("https://i.ibb.co.com/Cs5Kr1gT/dc262f1cd78130b972c5dbd8643ad972.jpg")
  status         Status      @default(active)
  verified       Boolean     @default(false)
  provider       Provider    @default(local)
  providerId     String?
  
  authIsResetPassword Boolean? @default(false)
  authOneTimeCode     Int?
  authExpireAt        DateTime?
  authOneTimeCodeAttempts Int? @default(0)
  authLockUntil       DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  resetTokens    ResetToken[]
  videos         Video[]     @relation("CreatedVideos")
  views          VideoView[]
  likes          VideoLike[]
  comments       Comment[]

  @@index([role, status])
  @@index([createdAt])
}

model ResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String
  expireAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  thumbnail String?
  status    Status   @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]
}

model Video {
  id           String   @id @default(uuid())
  title        String
  subtitle     String
  videoUrl     String
  thumbnailUrl String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  hashtags     String[]
  status       Status   @default(active)
  createdBy    String
  creator      User     @relation("CreatedVideos", fields: [createdBy], references: [id])
  storageType  String   @default("local") // "local" | "cloudinary"
  publicId     String?  // Cloudinary public_id or local filename for deletion
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  views        VideoView[]
  likes        VideoLike[]
  comments     Comment[]

  @@index([categoryId])
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([createdBy])
}

model VideoView {
  id       String   @id @default(uuid())
  userId   String
  videoId  String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  video    Video    @relation(fields: [videoId], references: [id])

  @@index([videoId])
  @@index([userId, videoId])
  @@index([userId, videoId, viewedAt])
  @@index([viewedAt])
}

model VideoLike {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Comment {
  id          String   @id @default(uuid())
  userId      String
  videoId     String
  commentText String
  status      Status   @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  video       Video    @relation(fields: [videoId], references: [id])

  @@index([videoId])
  @@index([videoId, status, createdAt])
  @@index([userId])
}

model StorageSetting {
  id        String   @id @default(uuid())
  provider  String   @default("local") // "local" | "cloudinary"
  cloudName String?
  apiKey    String?
  apiSecret String?
  updatedAt DateTime @updatedAt
}

model EmailSetting {
  id        String   @id @default(uuid())
  provider  String   @default("smtp") // "smtp" | "resend"
  host      String?  @default("smtp.resend.com")
  port      Int?     @default(587)
  secure    Boolean  @default(false)
  user      String?  @default("resend")
  pass      String?
  fromEmail String?  @default("no-reply@kurius.cloud")
  fromName  String?  @default("Kurius")
  updatedAt DateTime @updatedAt
}

model LegalPolicy {
  id        String   @id @default(uuid())
  type      String   @unique // "privacy" | "terms"
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model MotivationalMessage {
  id        String   @id @default(uuid())
  message   String   @db.Text
  author    String?
  status    Status   @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

